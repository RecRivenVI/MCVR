#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0,std430) readonly buffer Execution { uint value; } execution;
layout(set=0,binding=1,std430) buffer Result { uint values[]; } result;
layout(push_constant) uniform Destination { uint slot; } destination;
void main() { result.values[destination.slot] = execution.value; }
