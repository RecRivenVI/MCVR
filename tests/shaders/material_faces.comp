#version 460
#extension GL_EXT_ray_query : require
#extension GL_GOOGLE_include_directive : require
#include "util/material_faces.glsl"
#include "util/ui_primary_visibility.glsl"
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform accelerationStructureEXT scene;
layout(set=0,binding=1,std430) buffer Results { uint result[]; };
layout(set=0,binding=2,std430) readonly buffer Cases { uvec4 cases[]; };
void main() {
    uint i=gl_GlobalInvocationID.x, c=i/4, g=(i/2)%2, side=i%2;
    float mirror=cases[c].z==0?1:-1;
    vec3 origin=vec3(mirror*(float(g)*3.0),float(c)*4.0,side==0?2:-2);
    rayQueryEXT ray;
    rayQueryInitializeEXT(ray,scene,gl_RayFlagsCullBackFacingTrianglesEXT,255,origin,0.001,vec3(0,0,side==0?-1:1),4);
    while(rayQueryProceedEXT(ray)) {
        uint geom=rayQueryGetIntersectionGeometryIndexEXT(ray,false);
        uint face=cases[c][geom];
        if (cases[c].w!=0) face=0; // uniform hardware path removes flags in production appearances
        if(acceptsMaterialFace(face,rayQueryGetIntersectionFrontFaceEXT(ray,false))) rayQueryConfirmIntersectionEXT(ray);
    }
    result[i]=rayQueryGetIntersectionTypeEXT(ray,true)==gl_RayQueryCommittedIntersectionTriangleEXT?1:0;
    uint primary=uiPrimaryTraceState(7u,0u);
    uint reflected=uiPrimaryTraceState(primary,1u);
    result[i] |= (acceptsUiOwner(1u<<24u,1u,primary)?2u:0u)
        | (acceptsUiOwner(2u<<24u,1u,primary)?4u:0u)
        | (acceptsUiOwner(2u<<24u,1u,reflected)?8u:0u)
        | (acceptsUiOwner(0u,1u,primary)?16u:0u)
        | (acceptsUiOwner(2u<<24u,0u,primary)?32u:0u);
}
