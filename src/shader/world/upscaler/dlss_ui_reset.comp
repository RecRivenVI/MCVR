#version 460
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0,rgba8) uniform image2D worldColor;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(worldColor)))) return;
    imageStore(worldColor, pixel, vec4(imageLoad(worldColor, pixel).rgb, 0.0));
}
