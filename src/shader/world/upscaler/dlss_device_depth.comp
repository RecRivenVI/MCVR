#version 460
layout(local_size_x=16, local_size_y=16) in;
layout(set=0,binding=0,r16f) uniform readonly image2D linearDepth;
layout(set=0,binding=1,r32f) uniform writeonly image2D hardwareDepth;
layout(push_constant) uniform Params { vec4 projectionZ; } params;
void main() {
    ivec2 pixel = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(pixel, imageSize(hardwareDepth)))) return;
    float d = imageLoad(linearDepth, pixel).r;
    vec4 p = params.projectionZ;
    float w = -d * p.z + p.w;
    float z = d >= 65000.0 || abs(w) < 1e-8 ? 1.0 : clamp((-d * p.x + p.y) / w, 0.0, 1.0);
    imageStore(hardwareDepth, pixel, vec4(z));
}
